procedure TfrmQuestion2.btnQ2_1_1Click(Sender: TObject);
var
  sSQL1: String;
begin
  // 2.1.1 iOS devices
  { Display the DeviceID and DeviceName of all devices in the tblDevices table,
    that use the iOS operating system. }
  sSQL1 := 'SELECT DeviceID, DeviceName FROM tblDevices WHERE OperatingSystem = "iOS"';

  // Provided code - do not change
  dbCONN.runSQL(sSQL1);
end;

procedure TfrmQuestion2.btnQ2_1_2Click(Sender: TObject);
var
  sSQL2: String;
  sDeviceType: String;
begin
  // Provided code
  sDeviceType := cmbQ2_1_2.Text;

  // 2.1.2 Category selected
  { Display the DeviceName, Category and NumInStock of all devices where the
    Category field contains the device type selected from the combo box. }
  sSQL2 := 'SELECT DeviceName, Category, NumInStock FROM tblDevices WHERE Category = "Smart '
    + sDeviceType + '"';

  // Provided code - do not change
  dbCONN.runSQL(sSQL2);
end;

procedure TfrmQuestion2.btnQ2_1_3Click(Sender: TObject);
var
  sSql3: String;
begin
  // 2.1.3 Online support
  { Display the DeviceName, Category and OperatingSystem of all devices that
    receive online support from the manufacturer. The results must be sorted in
    alphabetical order according to the DeviceName. }
  sSql3 := 'SELECT DeviceName, Category, OperatingSystem FROM tblDevices AS D, tblManufacturers AS M WHERE D.ManufacturerID = M.ManufacturerID AND OnlineSupport = TRUE ORDER BY DeviceName';

  // Provided code - do not change
  dbCONN.runSQL(sSql3);
end;

